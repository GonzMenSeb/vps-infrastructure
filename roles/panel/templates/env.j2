PORT={{ panel_app_port }}
PANEL_HOST={{ panel_host }}
PUBLIC_URL=https://{{ panel_host }}
DATA_DIR=/opt/panel/data
SERVICES_MANIFEST_PATH=/opt/panel/services.json
GITHUB_CLIENT_ID={{ vault_panel_github_client_id }}
GITHUB_CLIENT_SECRET={{ vault_panel_github_client_secret }}
GITHUB_ALLOWED_LOGIN={{ grafana_github_admin_login }}
SESSION_SECRET={{ vault_panel_session_secret }}
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
ZOT_URL=http://zot:5000
ZOT_USER={{ zot_registry_user }}
ZOT_PASSWORD={{ vault_zot_registry_password }}
ZOT_GC_DELAY={{ zot_gc_delay }}
ZOT_GC_INTERVAL={{ zot_gc_interval }}
PDNS_API_URL=http://pdns:8081
PDNS_API_KEY={{ vault_pdns_api_key }}
JENKINS_URL=https://{{ jenkins_host }}
JENKINS_USER=admin
JENKINS_TOKEN={{ vault_panel_jenkins_token }}
TIME_ZONE={{ panel_time_zone }}
POLL_DEMAND_WINDOW_MS={{ panel_poll_demand_window_ms }}
POLL_IDLE_INTERVAL_MS={{ panel_poll_idle_interval_ms }}
POLL_TICK_MS={{ panel_poll_tick_ms }}
