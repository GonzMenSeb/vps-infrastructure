#!/bin/sh
set -eu
export LC_ALL=C
dir=${AGENT_HOST_TEXTFILE_DIR:-{{ agent_host_textfile_dir }}}
root=${AGENT_HOST_ROOT:-}
tmp=$(mktemp "$dir/.agent_host_settings.XXXXXX")
trap 'rm -f "$tmp"' EXIT
check() {
  setting=$1
  shift
  if "$@" >/dev/null 2>&1; then ok=1; else ok=0; fi
  printf 'agent_host_setting_ok{setting="%s"} %s\n' "$setting" "$ok" >>"$tmp"
}
sysval() { cat "$root/proc/sys/$1" 2>/dev/null || true; }
{% if 'ssh_password_off' in agent_host_reporting_settings_ids %}
sshd_t=$(sshd -T 2>/dev/null || true)
sshd_val() { printf '%s\n' "$sshd_t" | awk -v k="$1" '$1 == k { $1 = ""; sub(/^ /, ""); print; exit }'; }
{% endif %}
{% if 'swap_active' in agent_host_reporting_settings_ids %}
swap_active() {
  awk -v f={{ agent_host_mem_swap_file | quote }} 'NR > 1 && $1 == f { found = 1 } END { exit !found }' "$root/proc/swaps" &&
    awk -v n={{ agent_host_mem_swap_size_mib | int * 1024 - 4 }} '/^SwapTotal:/ { t = $2 } END { exit !(t + 0 >= n + 0) }' "$root/proc/meminfo"
}
{% endif %}
{% if 'ssh_rollback_idle' in agent_host_reporting_settings_ids %}
rollback_idle() {
  for u in agent-host-sshd-rollback agent-host-ufw-rollback; do
    [ "$(systemctl is-active "$u.timer" 2>/dev/null || true)" = inactive ] || return 1
  done
}
{% endif %}
{% if agent_host_reporting_settings_ids | length > 0 %}
printf '%s\n' '# HELP agent_host_setting_ok 1 when the live state equals what the agent_host role rendered, 0 on drift.' '# TYPE agent_host_setting_ok gauge' >"$tmp"
{% endif %}
{% if 'congestion_control' in agent_host_reporting_settings_ids %}
check congestion_control test "$(sysval net/ipv4/tcp_congestion_control)" = {{ agent_host_net_sysctl['net.ipv4.tcp_congestion_control'] | string | quote }}
{% endif %}
{% if 'inotify_watches' in agent_host_reporting_settings_ids %}
check inotify_watches test "$(sysval fs/inotify/max_user_watches)" -ge {{ agent_host_sess_sysctl['fs.inotify.max_user_watches'] | int }}
{% endif %}
{% if 'inotify_instances' in agent_host_reporting_settings_ids %}
check inotify_instances test "$(sysval fs/inotify/max_user_instances)" -ge {{ agent_host_sess_sysctl['fs.inotify.max_user_instances'] | int }}
{% endif %}
{% if 'swap_active' in agent_host_reporting_settings_ids %}
check swap_active swap_active
{% endif %}
{% if 'zswap' in agent_host_reporting_settings_ids %}
check zswap test "$(cat "$root/sys/module/zswap/parameters/enabled" 2>/dev/null)" = Y
{% endif %}
{% if 'ssh_publickey_only' in agent_host_reporting_settings_ids %}
check ssh_publickey_only test "$(sshd_val authenticationmethods)" = {{ agent_host_ssh_auth['AuthenticationMethods'] | string | quote }}
{% endif %}
{% if 'ssh_password_off' in agent_host_reporting_settings_ids %}
check ssh_password_off test "$(sshd_val passwordauthentication)" = no
{% endif %}
{% if 'ssh_keepalive' in agent_host_reporting_settings_ids %}
check ssh_keepalive test "$(sshd_val clientaliveinterval) $(sshd_val clientalivecountmax)" = {{ (agent_host_ssh_transport['ClientAliveInterval'] ~ ' ' ~ agent_host_ssh_transport['ClientAliveCountMax']) | quote }}
{% endif %}
{% if 'ssh_guard_intact' in agent_host_reporting_settings_ids %}
check ssh_guard_intact test "$(sha256sum "$root/etc/ssh/sshd_config.d/00-no-password.conf" 2>/dev/null | cut -d' ' -f1)" = {{ 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' | hash('sha256') }}
{% endif %}
{% if 'ssh_rollback_idle' in agent_host_reporting_settings_ids %}
check ssh_rollback_idle rollback_idle
{% endif %}
{% if 'mosh_installed' in agent_host_reporting_settings_ids %}
check mosh_installed test "$(dpkg-query -W -f='${Status}' mosh 2>/dev/null)" = 'install ok installed'
{% endif %}
{% if 'limits_nofile' in agent_host_reporting_settings_ids %}
check limits_nofile grep -qxF {{ (agent_host_user ~ ' soft nofile ' ~ agent_host_limits_nofile_soft) | quote }} "$root/etc/security/limits.d/60-agent-host.conf"
{% endif %}
{% if 'linger' in agent_host_reporting_settings_ids %}
check linger test "$(loginctl show-user {{ agent_host_user | quote }} -p Linger --value 2>/dev/null)" = yes
{% endif %}
{
  printf '%s\n' '# HELP agent_host_settings_run_timestamp_seconds Unix time of the last settings check.' '# TYPE agent_host_settings_run_timestamp_seconds gauge'
  printf 'agent_host_settings_run_timestamp_seconds %s\n' "$(date +%s)"
  printf '%s\n' '# HELP agent_host_kernel_info The running kernel and the newest installed kernel.' '# TYPE agent_host_kernel_info gauge'
  printf 'agent_host_kernel_info{running="%s",newest="%s"} 1\n' "$(uname -r)" "$(find "$root/lib/modules" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sort -V | tail -n 1)"
} >>"$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$dir/{{ agent_host_reporting_settings_prom | basename }}"
