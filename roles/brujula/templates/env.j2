# Gemini. Deliberately the SAME key as DecaBot, by the repo owner's decision — the coros
# apps have no key pool and no bind_key(), so there is one key and one quota to watch.
GEMINI_API_KEY={{ vault_decabot_gemini_api_key }}

# The gate. One shared password, no username. state.py computes GATE_ON = bool(this), so
# UNSET WOULD MEAN NO GATE — never template this empty on a public host.
BRUJULA_PASSWORD={{ vault_brujula_password }}

# CORS narrowing, and it is a security control. Reflex puts its OWN policy on every route
# it serves — App._add_cors(api_transformer) runs on the line above the mount — and
# cors_allowed_origins defaults to ("*",) while _add_cors passes allow_credentials=True, so
# any site can make credentialed cross-origin requests to the backend and read the answers.
# Measured under granian 30 Jul 2026: `Origin: https://evil.example` came back mirrored.
# Unlike *_API_URL this is read at worker boot by get_config(), not baked into the bundle,
# so a value here is what narrows it. One origin is enough: the page and the backend are
# the same origin in production, which is the point of the single-port design.
# The reader landed 30 Jul 2026: apps/brujula/rxconfig.py reads BRUJULA_ALLOWED_ORIGINS and
# hands it to rx.Config(cors_allowed_origins=...), so this line is what CLOSES the exposure
# described above, not a placeholder for a fix that has not arrived. Its dev default is both
# spellings of :3000 — engineio compares Origin as an exact string, so a browser that was
# given 127.0.0.1 does not match a list holding only localhost.
BRUJULA_ALLOWED_ORIGINS=https://{{ brujula_host }}

# BRUJULA_API_URL is deliberately absent, not forgotten. rxconfig.py reads it at *compile*
# time and bakes the result into the frontend bundle, so a value here reaches a bundle that
# was already built and does nothing. Its own comment says the override exists for a dev
# tunnel only; the baked http://localhost:8000 is what lets one image serve every domain,
# because the compiled client rewrites the host to window.location.hostname and upgrades
# ws:->wss:. This is why there is no CONCIERGE_API_URL-style line here.
