jenkins:
  systemMessage: "VPS Infrastructure CI/CD - Managed by Ansible"
  numExecutors: 2
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: admin
          password: "{{ vault_jenkins_admin_password }}"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
  globalNodeProperties:
    - envVars:
        env:
          - key: "REGISTRY"
            value: "{{ zot_host }}"
          - key: "VPS_HOST"
            value: "ubuntu@{{ vault_main_vps_ip }}"
          - key: "PANEL_URL"
            value: "https://{{ panel_host }}"
          - key: "PANEL_SECRET_VARS"
            value: "{{ panel_secret_vars | join(' ') }}"
          - key: "PANEL_HASH_VARS"
            value: "{{ panel_hash_vars | join(' ') }}"
          - key: "PANEL_SECRETS_REPO"
            value: "{{ github_repo_ssh_url }}"

credentials:
  system:
    domainCredentials:
      - credentials:
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-ssh-key"
              username: "git"
              description: "GitHub deploy key (vps-infrastructure)"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_github_ssh_key | indent(20) }}
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-miplata-ssh-key"
              username: "git"
              description: "GitHub deploy key (miplata)"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_miplata_ssh_key | indent(20) }}
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-categorizer-ssh-key"
              username: "git"
              description: "GitHub deploy key (miplata-categorizer)"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_categorizer_ssh_key | indent(20) }}
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-decabot-ssh-key"
              username: "git"
              description: "GitHub deploy key (Los-Prompteros-Project / DecaBot)"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_decabot_ssh_key | indent(20) }}
          # One key, both coros jobs: brujula-deploy and huella-deploy read the same monorepo.
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-coros-ssh-key"
              username: "git"
              description: "GitHub deploy key (corosBot / Brujula + Huella)"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_coros_ssh_key | indent(20) }}
          # Write-scoped, unlike the deploy keys above. Only panel-secrets uses it, to push
          # vault edits to main; the GitHub deploy key for this repo must be added with write access.
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-write-ssh-key"
              username: "git"
              description: "GitHub write key (vps-infrastructure, panel-secrets only)"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_github_write_ssh_key | indent(20) }}
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "vps-ssh-key"
              username: "ubuntu"
              description: "VPS deploy key"
              privateKeySource:
                directEntry:
                  privateKey: |
                    {{ vault_jenkins_vps_ssh_key | indent(20) }}
          - string:
              scope: GLOBAL
              id: "ansible-vault-pass"
              secret: "{{ vault_ansible_vault_password }}"
              description: "Ansible vault password"
          - usernamePassword:
              scope: GLOBAL
              id: "zot-registry-creds"
              username: "{{ zot_registry_user }}"
              password: "{{ vault_zot_registry_password }}"
              description: "Credentials for the self-hosted Zot registry"
          - string:
              scope: GLOBAL
              id: "categorizer-api-token"
              description: "Bearer token for https://{{ categorizer_host }} - used by Eval Gate"
              secret: "{{ vault_categorizer_api_token }}"

# Adding a NEW job here needs a "Reload Configuration from Disk" after the play, or a
# second restart. JCasC's job DSL runs at SYSTEM_CONFIG_ADAPTED and writes the new
# jobs/<name>/config.xml, but the item map has already been built, so the job exists on
# disk and 404s in the UI and API until Jenkins re-reads it. Existing jobs update in
# place and are unaffected. Observed on decabot-deploy, 29 Jul 2026:
#   curl -u admin:… -X POST https://jenkins.web.vespiridion.org/reload
jobs:
  - script: |
      pipelineJob('vps-deploy') {
        description('Deploy VPS infrastructure via Ansible')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ github_repo_ssh_url }}')
                  credentials('github-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  - script: |
      pipelineJob('miplata-deploy') {
        description('Build miplata, push to self-hosted Zot registry, deploy to VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ miplata_repo_ssh_url }}')
                  credentials('github-miplata-ssh-key')
                }
                branches('*/master')
              }
            }
            scriptPath('infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  - script: |
      pipelineJob('decabot-deploy') {
        description('Build DecaBot, push to self-hosted Zot registry, deploy + health-check on VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ decabot_repo_ssh_url }}')
                  credentials('github-decabot-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  - script: |
      pipelineJob('judicabot-deploy') {
        description('Test judicabot, push to self-hosted Zot registry, deploy + health-check on VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ judicabot_repo_url }}')
                }
                branches('*/main')
              }
            }
            scriptPath('infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  - script: |
      pipelineJob('categorizer-deploy') {
        description('Build miplata-categorizer, push to self-hosted Zot registry, deploy + migrate on VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ categorizer_repo_ssh_url }}')
                  credentials('github-categorizer-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  # Two jobs, one repo and one Jenkinsfile: the monorepo's pipeline gates on touched paths
  # and pushes two separate images. Both jobs therefore fire on every push to main and it is
  # the Jenkinsfile that decides which app is rebuilt.
  - script: |
      pipelineJob('brujula-deploy') {
        description('Build Brujula from the corosBot monorepo, push to self-hosted Zot registry, deploy + health-check on VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ coros_repo_ssh_url }}')
                  credentials('github-coros-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  - script: |
      pipelineJob('huella-deploy') {
        description('Build Huella from the corosBot monorepo, push to self-hosted Zot registry, deploy + health-check on VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ coros_repo_ssh_url }}')
                  credentials('github-coros-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  - script: |
      pipelineJob('panel-deploy') {
        description('Build the panel from the vps-infrastructure monorepo (panel/), push to self-hosted Zot registry, deploy + health-check on VPS')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ github_repo_ssh_url }}')
                  credentials('github-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('panel/infra/jenkins/Jenkinsfile')
          }
        }
        triggers {
          githubPush()
        }
        properties {
          disableConcurrentBuilds()
        }
      }
  # Started only by the panel (no trigger). The parameters are declared here rather than in the
  # Jenkinsfile because a Jenkinsfile registers them after the first run, and the panel's first
  # buildWithParameters would be refused. Job DSL has no passwordParam, so VAR_VALUE is added as
  # the core PasswordParameterDefinition through configure.
  - script: |
      pipelineJob('panel-secrets') {
        description('Set one allowlisted variable in vault.yml (or group_vars for hash variables), commit and push to main. Started by the admin panel.')
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ github_repo_ssh_url }}')
                  credentials('github-ssh-key')
                }
                branches('*/main')
              }
            }
            scriptPath('infra/jenkins/panel-secrets.Jenkinsfile')
          }
        }
        parameters {
          stringParam('VAR_NAME', '', 'Variable to set; must be in PANEL_SECRET_VARS or PANEL_HASH_VARS')
        }
        configure { project ->
          project / 'properties' / 'hudson.model.ParametersDefinitionProperty' / 'parameterDefinitions' << 'hudson.model.PasswordParameterDefinition' {
            name('VAR_VALUE')
            description('New value. Never printed; kept only encrypted in the build record.')
            defaultValue('')
          }
        }
        logRotator(-1, 10)
        properties {
          disableConcurrentBuilds()
        }
      }


unclassified:
  location:
    url: "https://{{ jenkins_host }}/"
