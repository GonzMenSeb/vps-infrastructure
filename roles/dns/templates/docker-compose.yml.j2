networks:
  dns_internal:
    driver: bridge
  proxy:
    external: true

volumes:
  pdns_db_data:
  pdns_admin_data:

services:
  pdns-db:
    image: {{ pdns_mariadb_image }}
    container_name: pdns-db
    restart: unless-stopped
    networks: [dns_internal]
    env_file: .env
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MYSQL_DATABASE: pdns
      MYSQL_USER: pdns
      MYSQL_PASSWORD: ${DB_PASSWORD}
    volumes:
      - pdns_db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10

  pdns:
    image: {{ pdns_image }}
    container_name: pdns
    restart: unless-stopped
    networks: [dns_internal]
    ports:
      - "{{ vps_public_ip }}:53:53/udp"
      - "{{ vps_public_ip }}:53:53/tcp"
    depends_on:
      pdns-db:
        condition: service_healthy
    volumes:
      - ./pdns.conf:/etc/powerdns/pdns.conf:ro

  pdns-admin:
    image: {{ pdns_admin_image }}
    container_name: pdns-admin
    restart: unless-stopped
    networks: [dns_internal]
    depends_on: [pdns]
    env_file: .env
    environment:
      SECRET_KEY: ${ADMIN_SECRET_KEY}
      SQLALCHEMY_DATABASE_URI: sqlite:////data/pdns-admin.db
      PDNS_API_URL: http://pdns:8081/
      PDNS_API_KEY: ${PDNS_API_KEY}
      PDNS_VERSION: "4.9"
      SIGNUP_ENABLED: "false"
      LOCAL_DB_ENABLED: "false"
      GITHUB_OAUTH_ENABLED: "true"
    volumes:
      - pdns_admin_data:/data

  pdns-auth:
    image: {{ oauth2_proxy_image }}
    container_name: pdns-auth
    restart: unless-stopped
    networks: [dns_internal, proxy]
    depends_on: [pdns-admin]
    environment:
      OAUTH2_PROXY_CLIENT_ID: ${GITHUB_OAUTH_KEY}
      OAUTH2_PROXY_CLIENT_SECRET: ${GITHUB_OAUTH_SECRET}
      OAUTH2_PROXY_COOKIE_SECRET: ${PDNS_AUTH_COOKIE_SECRET}
    command:
      - --provider=github
      - --github-user={{ pdns_admin_github_login }}
      - "--email-domain=*"
      - --upstream=http://pdns-admin:80
      - --http-address=0.0.0.0:4180
      - --redirect-url=https://{{ pdns_admin_host }}/oauth2/callback
      - --skip-provider-button=true
      - --cookie-secure=true
      - --cookie-samesite=lax
      - --cookie-expire=12h
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pdns-admin.rule=Host(`{{ pdns_admin_host }}`)"
      - "traefik.http.routers.pdns-admin.entrypoints=websecure"
      - "traefik.http.routers.pdns-admin.tls.certresolver=letsencrypt"
      - "traefik.http.services.pdns-admin.loadbalancer.server.port=4180"
