# Gemini. Reserved for the demo — the app deliberately keeps GEMINI_API_KEY out of any
# public round-robin pool, because per-project quota is what runs out first.
GEMINI_API_KEY={{ vault_decabot_gemini_api_key }}

# The gate. One shared password, no username: what it protects is the Gemini quota and
# Decathlon's MCP rate limiter (a lockout is ~48 minutes), not per-visitor data.
# UNSET WOULD MEAN NO GATE — never template this empty on a public host.
DECABOT_PASSWORD={{ vault_decabot_password }}

# Public-load protection. Left off deliberately: CONCIERGE_VIP_TOKEN unset means nobody
# queues, which is the safe default — a typo must not put the demo itself in a line.
CONCIERGE_VIP_TOKEN=
CONCIERGE_PUBLIC_SLOTS={{ decabot_public_slots }}
GEMINI_PUBLIC_KEYS=

# Live catalog, not the canned run. 1 falls back to fixtures if Gemini is down.
CONCIERGE_FIXTURE_MODE=0

# NOT the public URL, and not a mistake. api_url is compiled into the frontend bundle;
# the bundle rewrites any localhost/0.0.0.0 value to whatever origin actually served the
# page and upgrades ws->wss. Setting the real hostname here would need a rebuilt image
# per domain and buys nothing.
CONCIERGE_API_URL=http://localhost:{{ decabot_app_port }}
