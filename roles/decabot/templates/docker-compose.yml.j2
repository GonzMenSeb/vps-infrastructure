networks:
  proxy:
    external: true

services:
  decabot:
    image: {{ decabot_image }}
    container_name: decabot
    restart: unless-stopped
    networks: [proxy]
    env_file: .env
    volumes:
      - {{ decabot_dir }}/states:/app/.states
    mem_limit: {{ decabot_mem_limit }}
    # No healthcheck here on purpose: the image already declares one against
    # /ping, and a second copy in this file is just something to drift.
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.decabot.rule=Host(`{{ decabot_host }}`)"
      - "traefik.http.routers.decabot.entrypoints=websecure"
      - "traefik.http.routers.decabot.tls.certresolver=letsencrypt"
      # One service, one port. The page and the /_event websocket are both on it —
      # Reflex mounts the compiled frontend onto the backend's ASGI app in prod, so
      # there is no second router and no path-based split to get wrong.
      - "traefik.http.services.decabot.loadbalancer.server.port={{ decabot_app_port }}"
      # No bearer/basicauth middleware. Access control is the app's own password gate,
      # which is enforced in Python inside every handler that spends a Gemini call —
      # a browser dialog cannot be styled, and the demo URL has to be handable to a
      # judge with nothing but a password to type.
