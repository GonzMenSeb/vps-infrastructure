# Gemini. Deliberately the SAME key as DecaBot, by the repo owner's decision — the coros
# apps have no key pool and no bind_key(), so there is one key and one quota to watch.
GEMINI_API_KEY={{ vault_decabot_gemini_api_key }}

# The gate. One shared password, no username. UNSET WOULD MEAN NO GATE — never template
# this empty on a public host.
HUELLA_PASSWORD={{ vault_huella_password }}

# Strava OAuth 2.0. strava/client.py reads all three from the environment at request time,
# so unlike the api_url these are real runtime values and the hostname belongs here.
# Strava validates the callback against the app's registered "Authorization Callback
# Domain", so huella.web.<domain> must be set there or the redirect is refused before it
# ever reaches us.
STRAVA_CLIENT_ID={{ vault_strava_client_id }}
STRAVA_CLIENT_SECRET={{ vault_strava_client_secret }}
# Served by the backend on the same single port as the page — a Starlette route on Reflex's
# api_transformer that outranks the compiled frontend's catch-all mount.
STRAVA_REDIRECT_URI=https://{{ huella_host }}/oauth/strava/callback

# HUELLA_API_URL has no reader: the app has no rxconfig.py yet. When it lands it will read
# its api_url at compile time exactly as brujula's does, so it does not belong in this file.
