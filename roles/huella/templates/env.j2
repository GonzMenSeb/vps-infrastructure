# Gemini. Deliberately the SAME key as DecaBot, by the repo owner's decision — the coros
# apps have no key pool and no bind_key(), so there is one key and one quota to watch.
GEMINI_API_KEY={{ vault_decabot_gemini_api_key }}

# The gate. One shared password, no username. UNSET WOULD MEAN NO GATE — never template
# this empty on a public host.
HUELLA_PASSWORD={{ vault_huella_password }}

# Strava OAuth 2.0. strava/client.py reads all three from the environment at request time,
# so unlike the api_url these are real runtime values and the hostname belongs here.
# Strava validates the callback against the app's registered "Authorization Callback
# Domain", so huella.web.<domain> must be set there or the redirect is refused before it
# ever reaches us.
STRAVA_CLIENT_ID={{ vault_strava_client_id }}
STRAVA_CLIENT_SECRET={{ vault_strava_client_secret }}
# Served by the backend on the same single port as the page — a Starlette route on Reflex's
# api_transformer that outranks the compiled frontend's catch-all mount.
STRAVA_REDIRECT_URI=https://{{ huella_host }}/oauth/strava/callback

# CORS narrowing, and it is a security control. Reflex puts its OWN policy on every route
# it serves — including the OAuth callback, since App._add_cors(api_transformer) runs on the
# line above the mount — and cors_allowed_origins defaults to ("*",) while _add_cors passes
# allow_credentials=True, so any site can make credentialed cross-origin requests to the
# backend and read the answers. Measured under granian 30 Jul 2026: `Origin:
# https://evil.example` came back mirrored, on the callback, with credentials allowed.
# Unlike *_API_URL this is read at worker boot by get_config(), not baked into the bundle,
# so a value here is what narrows it. One origin is enough: the page and the backend are
# the same origin in production, which is the point of the single-port design. Strava's own
# redirect is unaffected either way — a top-level navigation carries no Origin.
# PENDING A READER — the app has no rxconfig.py yet; the reader lands with the app-side
# rxconfig/app change (with a test). Until then this line is inert, not wrong, and the
# exposure above is still open. Do not "clean it up".
HUELLA_ALLOWED_ORIGINS=https://{{ huella_host }}

# HUELLA_API_URL has no reader either, for the same reason. When it lands it will read
# its api_url at compile time exactly as brujula's does, so it does not belong in this file.
